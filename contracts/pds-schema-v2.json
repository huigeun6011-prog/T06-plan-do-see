{
  "version": "pds-schema-v2",
  "timezone": "Asia/Seoul",
  "date_rules": {
    "weekly_reset": "Thursday 00:00 KST",
    "monthly_reset": "First day of the month at 00:00 KST",
    "calendar_dates": "DATE columns store Seoul calendar dates and export as YYYY-MM-DD.",
    "instants": "TIMESTAMPTZ columns store instants and export as ISO 8601 strings with an offset.",
    "deadline": "The deadline is the exclusive end. Midnight is displayed as 24:00 on the last included day."
  },
  "units": {
    "minutes": { "type": "integer", "minimum": 0, "unit": "minute" },
    "reward_meso": { "type": "bigint", "minimum": 0, "unit": "meso", "export_type": "string" },
    "ids": { "type": "bigint", "export_type": "string" }
  },
  "enums": {
    "period_kind": ["weekly", "monthly", "event"],
    "use_yn": ["Y", "N"]
  },
  "tables": {
    "game_character": {
      "kind": "table",
      "columns": {
        "id": { "type": "bigint", "nullable": false, "default": "GENERATED ALWAYS AS IDENTITY" },
        "name": { "type": "text", "nullable": false, "default": null },
        "sort_order": { "type": "integer", "nullable": false, "default": "0" },
        "created_at": { "type": "timestamp with time zone", "nullable": false, "default": "now()" }
      },
      "primary_key": ["id"],
      "unique_indexes": [
        { "name": "game_character_name_key", "columns": ["name"], "where": null }
      ],
      "checks": ["Name is nonempty."]
    },
    "entry": {
      "kind": "table",
      "columns": {
        "id": { "type": "bigint", "nullable": false, "default": "GENERATED BY DEFAULT AS IDENTITY" },
        "root_id": { "type": "bigint", "nullable": false, "default": null },
        "character_id": { "type": "bigint", "nullable": true, "default": null },
        "title": { "type": "text", "nullable": false, "default": null },
        "period_kind": { "type": "text", "nullable": false, "default": null },
        "clear_minutes": { "type": "integer", "nullable": false, "default": null },
        "reward_meso": { "type": "bigint", "nullable": false, "default": "0" },
        "party_size": { "type": "integer", "nullable": false, "default": "1" },
        "doping": { "type": "text", "nullable": false, "default": "'base'" },
        "memo": { "type": "text", "nullable": false, "default": "''" },
        "target_count": { "type": "integer", "nullable": false, "default": "1" },
        "tags": { "type": "text[]", "nullable": false, "default": "'{}'" },
        "sort_order": { "type": "integer", "nullable": false, "default": "0" },
        "use_yn": { "type": "character(1)", "nullable": false, "default": "'Y'" },
        "created_at": { "type": "timestamp with time zone", "nullable": false, "default": "now()" }
      },
      "primary_key": ["id"],
      "unique_indexes": [
        { "name": "entry_one_current", "columns": ["root_id"], "where": "use_yn = 'Y'" },
        { "name": "entry_one_per_title", "columns": ["COALESCE(character_id, 0)", "title"], "where": "use_yn = 'Y'" }
      ],
      "checks": [
        "Title is nonempty.",
        "Period kind is weekly or monthly.",
        "Clear minutes, party size and target count are at least 1.",
        "Reward meso is nonnegative.",
        "Use flag is Y or N."
      ]
    },
    "plan": {
      "kind": "table",
      "columns": {
        "id": { "type": "bigint", "nullable": false, "default": "GENERATED BY DEFAULT AS IDENTITY" },
        "root_id": { "type": "bigint", "nullable": false, "default": null },
        "period_kind": { "type": "text", "nullable": false, "default": null },
        "title": { "type": "text", "nullable": false, "default": "''" },
        "starts_at": { "type": "timestamp with time zone", "nullable": false, "default": null },
        "ends_at": { "type": "timestamp with time zone", "nullable": false, "default": null },
        "priority": { "type": "smallint", "nullable": false, "default": "2" },
        "success_criteria": { "type": "text", "nullable": false, "default": null },
        "expected_minutes": { "type": "integer", "nullable": false, "default": "0" },
        "use_yn": { "type": "character(1)", "nullable": false, "default": "'Y'" },
        "created_at": { "type": "timestamp with time zone", "nullable": false, "default": "now()" }
      },
      "primary_key": ["id"],
      "unique_indexes": [
        { "name": "plan_one_current", "columns": ["root_id"], "where": "use_yn = 'Y'" },
        { "name": "plan_one_per_period", "columns": ["period_kind", "starts_at"], "where": "use_yn = 'Y' AND period_kind <> 'event'" }
      ],
      "checks": [
        "Period kind is weekly, monthly or event.",
        "Priority is 1 through 3.",
        "Success criteria are nonempty.",
        "Expected minutes are nonnegative.",
        "Use flag is Y or N.",
        "End is strictly after start."
      ]
    },
    "todo": {
      "kind": "table",
      "columns": {
        "id": { "type": "bigint", "nullable": false, "default": "GENERATED ALWAYS AS IDENTITY" },
        "plan_id": { "type": "bigint", "nullable": false, "default": null },
        "entry_id": { "type": "bigint", "nullable": true, "default": null },
        "source_plan_id": { "type": "bigint", "nullable": true, "default": null },
        "title": { "type": "text", "nullable": false, "default": null },
        "note": { "type": "text", "nullable": false, "default": "''" },
        "character_id": { "type": "bigint", "nullable": true, "default": null },
        "due_at": { "type": "timestamp with time zone", "nullable": false, "default": null },
        "priority": { "type": "smallint", "nullable": false, "default": "2" },
        "tags": { "type": "text[]", "nullable": false, "default": "'{}'" },
        "expected_minutes": { "type": "integer", "nullable": false, "default": "0" },
        "target_count": { "type": "integer", "nullable": false, "default": "1" },
        "miss_reason": { "type": "text", "nullable": true, "default": null },
        "use_yn": { "type": "character(1)", "nullable": false, "default": "'Y'" },
        "created_at": { "type": "timestamp with time zone", "nullable": false, "default": "now()" }
      },
      "primary_key": ["id"],
      "unique_indexes": [
        { "name": "todo_plan_id_entry_id_key", "columns": ["plan_id", "entry_id"], "where": null },
        { "name": "todo_one_improvement", "columns": ["source_plan_id"], "where": "source_plan_id IS NOT NULL AND use_yn = 'Y'" }
      ],
      "checks": [
        "Title is nonempty.",
        "Priority is 1 through 3.",
        "Expected minutes are nonnegative and target count is at least 1.",
        "Miss reason is null or nonempty and at most 200 characters.",
        "Use flag is Y or N."
      ]
    },
    "run_record": {
      "kind": "table",
      "columns": {
        "id": { "type": "bigint", "nullable": false, "default": "GENERATED ALWAYS AS IDENTITY" },
        "todo_id": { "type": "bigint", "nullable": false, "default": null },
        "run_date": { "type": "date", "nullable": false, "default": null },
        "units": { "type": "integer", "nullable": false, "default": "1" },
        "started_at": { "type": "timestamp with time zone", "nullable": true, "default": null },
        "ended_at": { "type": "timestamp with time zone", "nullable": true, "default": null },
        "actual_minutes": { "type": "integer", "nullable": true, "default": null },
        "done": { "type": "boolean", "nullable": false, "default": "true" },
        "use_yn": { "type": "character(1)", "nullable": false, "default": "'Y'" },
        "created_at": { "type": "timestamp with time zone", "nullable": false, "default": "now()" }
      },
      "primary_key": ["id"],
      "unique_indexes": [
        { "name": "run_one_per_day", "columns": ["todo_id", "run_date"], "where": "use_yn = 'Y'" }
      ],
      "checks": [
        "Units are at least 1.",
        "Actual minutes are null or nonnegative.",
        "Use flag is Y or N.",
        "If both times are present, the end is at or after the start."
      ]
    },
    "todo_state": {
      "kind": "view",
      "columns": {
        "id": { "type": "bigint", "nullable": true, "default": null },
        "plan_id": { "type": "bigint", "nullable": true, "default": null },
        "entry_id": { "type": "bigint", "nullable": true, "default": null },
        "source_plan_id": { "type": "bigint", "nullable": true, "default": null },
        "title": { "type": "text", "nullable": true, "default": null },
        "note": { "type": "text", "nullable": true, "default": null },
        "character_id": { "type": "bigint", "nullable": true, "default": null },
        "due_at": { "type": "timestamp with time zone", "nullable": true, "default": null },
        "priority": { "type": "smallint", "nullable": true, "default": null },
        "tags": { "type": "text[]", "nullable": true, "default": null },
        "expected_minutes": { "type": "integer", "nullable": true, "default": null },
        "target_count": { "type": "integer", "nullable": true, "default": null },
        "miss_reason": { "type": "text", "nullable": true, "default": null },
        "use_yn": { "type": "character(1)", "nullable": true, "default": null },
        "created_at": { "type": "timestamp with time zone", "nullable": true, "default": null },
        "done_n": { "type": "integer", "nullable": true, "default": null },
        "actual_minutes": { "type": "integer", "nullable": true, "default": null },
        "blocked": { "type": "boolean", "nullable": true, "default": null },
        "is_done": { "type": "boolean", "nullable": true, "default": null }
      },
      "primary_key": [],
      "unique_indexes": [],
      "checks": [],
      "note": "Nullability reflects information_schema metadata for views. The view returns current todos only. done_n and actual_minutes sum current completed runs, with zero for no data. blocked means miss_reason is present. is_done means done_n is at least target_count."
    }
  },
  "relations": [
    { "from": "entry.root_id", "to": "entry.id", "kind": "foreign_key", "note": "First version ID." },
    { "from": "entry.character_id", "to": "game_character.id", "kind": "foreign_key", "note": "NULL is account-level." },
    { "from": "plan.root_id", "to": "plan.id", "kind": "foreign_key", "note": "First version ID." },
    { "from": "todo.plan_id", "to": "plan.id", "kind": "foreign_key", "note": "Holds the plan ROOT ID." },
    { "from": "todo.entry_id", "to": "entry.id", "kind": "foreign_key", "note": "Holds the registration ROOT ID. NULL is hand-made." },
    { "from": "todo.source_plan_id", "to": "plan.id", "kind": "foreign_key", "note": "Source plan ROOT ID for an improvement." },
    { "from": "todo.character_id", "to": "game_character.id", "kind": "foreign_key", "note": "NULL is account-level." },
    { "from": "run_record.todo_id", "to": "todo.id", "kind": "foreign_key" },
    { "from": "todo_state", "to": "todo", "kind": "view_source" },
    { "from": "todo_state.id", "to": "run_record.todo_id", "kind": "view_aggregate" }
  ],
  "versioning": {
    "tables": ["entry", "plan"],
    "current": "Match root_id and use_yn = 'Y'. An edit retires the current row and inserts a replacement with the same root_id.",
    "original": "The first row has id = root_id. History is ordered by id ascending.",
    "soft_delete": "A row with use_yn = 'N' is inactive. Todos and run records are edited in place and use this flag for deletion."
  },
  "aggregates": {
    "source": "todo_state for one plan ROOT ID. Empty plans have zero totals.",
    "plan_count": "Count of all current todos.",
    "done_count": "Count of todos with is_done.",
    "late_count": "Count of todos with NOT is_done AND due_at <= as_of, where as_of is supplied by the caller.",
    "blocked_count": "Count of todos with blocked (miss_reason is not NULL).",
    "expected_minutes": "Sum of todo expected_minutes.",
    "actual_minutes": "Sum of todo actual_minutes, which sums minutes from current runs with done = true.",
    "diff_minutes": "Actual minutes minus expected minutes.",
    "scopes": {
      "all": "TRUE",
      "open": "NOT is_done",
      "done": "is_done",
      "late": "NOT is_done AND due_at <= as_of",
      "blocked": "blocked"
    }
  }
}
